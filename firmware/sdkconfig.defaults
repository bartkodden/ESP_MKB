# ESP_MKB sdkconfig.defaults

# ── Compiler optimization (choice group) ──────────────────────────────────────
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_SIZE=y

# ── Partition table (choice group) ────────────────────────────────────────────
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── Watchdog ──────────────────────────────────────────────────────────────────
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# ── Flash size (choice group) ─────────────────────────────────────────────────
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# ── Stack size ───────────────────────────────────────────────────────────────
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# ── WiFi IRAM ─────────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_SPI_MASTER_ISR_IN_IRAM=n

# ── WiFi features ─────────────────────────────────────────────────────────────
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n
CONFIG_ESP_WIFI_ENABLE_SAE_PK=n
CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT=n
CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6

# ── Newlib ────────────────────────────────────────────────────────────────────
CONFIG_NEWLIB_NANO_FORMAT=y

# ── Heap ──────────────────────────────────────────────────────────────────────
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# ── Network ───────────────────────────────────────────────────────────────────
CONFIG_LWIP_LOCAL_HOSTNAME="esp-mkb"

# ── AsyncTCP ──────────────────────────────────────────────────────────────────
CONFIG_ASYNC_TCP_RUNNING_CORE=1

# ── Bluetooth ─────────────────────────────────────────────────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTS_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_SMP_ENABLE=y
CONFIG_BT_SMP_MAX_BONDS=15
CONFIG_BT_GATT_MAX_SR_PROFILES=8
CONFIG_BT_GATT_MAX_SR_ATTRIBUTES=100
CONFIG_BT_GATTC_MAX_CACHE_CHAR=60
CONFIG_BT_GATTC_NOTIF_REG_MAX=10
CONFIG_BT_BLE_ESTAB_LINK_CONN_TOUT=30
CONFIG_BT_ACL_CONNECTIONS=4
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=6144
CONFIG_BT_ALARM_MAX_NUM=100
CONFIG_BTDM_BLE_SCAN_DUPL=y
CONFIG_BTDM_SCAN_DUPL_TYPE=0
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=20

# ── BT Controller ─────────────────────────────────────────────────────────────
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3

# ── BT + WiFi coexistence ─────────────────────────────────────────────────────
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# ── Arduino ───────────────────────────────────────────────────────────────────
CONFIG_ARDUINO_SELECTIVE_COMPILATION=y
CONFIG_ARDUINO_SELECTIVE_BTSERIAL=n
CONFIG_ARDUINO_SELECTIVE_BLE=n

# ── AsyncTCP ──────────────────────────────────────────────────────────────────
CONFIG_FREERTOS_HZ=1000

# ── TFT_eSPI ──────────────────────────────────────────────────────────────────
CONFIG_TFT_eSPI_ESPIDF=y
CONFIG_TFT_ST7789_2_DRIVER=y
CONFIG_TFT_RGB_ORDER=y
CONFIG_TFT_WIDTH=240
CONFIG_TFT_HEIGHT=280
CONFIG_TFT_INVERSION_DISABLE=y
CONFIG_TFT_SPI=y
CONFIG_TFT_VSPI_PORT=y
CONFIG_TFT_MISO=-1
CONFIG_TFT_MOSI=13
CONFIG_TFT_SCLK=14
CONFIG_TFT_SPI_FREQUENCY=27000000
CONFIG_TFT_SPI_READ_FREQ=20000000
CONFIG_TFT_CS=15
CONFIG_TFT_DC=27
CONFIG_TFT_RST=-1
CONFIG_ENABLE_BL=y
CONFIG_TFT_BL=26
CONFIG_TFT_BACKLIGHT_ON_HIGH=y
CONFIG_TFT_BACKLIGHT_ON=1
CONFIG_TFT_LOAD_GLCD=y
CONFIG_TFT_LOAD_FONT2=y
CONFIG_TFT_LOAD_FONT4=y
CONFIG_TFT_LOAD_FONT6=y
CONFIG_TFT_LOAD_FONT7=y
CONFIG_TFT_LOAD_FONT8=y
CONFIG_TFT_LOAD_GFXFF=y
CONFIG_TFT_SMOOTH_FONT=y